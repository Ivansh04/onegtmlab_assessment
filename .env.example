# Copy to .env for local development. Never commit .env.
ENVIRONMENT=development
LOG_LEVEL=INFO

# Forager: get API key and account ID from app.forager.ai
FORAGER_API_KEY=
FORAGER_ACCOUNT_ID=
FORAGER_API_BASE_URL=https://api-v2.forager.ai

# HubSpot private app token with required CRM company/contact read+write scopes
HUBSPOT_ACCESS_TOKEN=
# Required for signed public-app webhook validation. Configure from your HubSpot app.
HUBSPOT_CLIENT_SECRET=
HUBSPOT_API_BASE_URL=https://api.hubapi.com

# Comma-separated current job-title filters for contact discovery
ALLOWED_JOB_TITLES=Engineer,CEO,CTO,Founder,Chief Technology Officer,VP Engineering,Head of Engineering,Director of Engineering
MAX_CONTACTS_PER_COMPANY=5
WEBHOOK_MAX_AGE_SECONDS=300
ENABLE_WEBHOOK_SIGNATURE_VALIDATION=true
